# Audio files
data/**/*.wav
data/**/*.mp3
data/**/*.flac

# Transcription files
data/**/*.vtt

# Large dataset files (spectrograms)
**/*.npy
Data_Prep/dataset/
Data_Prep/dataset_full/
Data_Prep/dataset_test/

# Model files (heavy)
*.pth
*.h5
*.pkl

# Large JSON data files
Data_Prep/aligned_dataset.json
X_data_*.npy
y_labels_*.npy

# Whisper models (very large) — wherever they live
**/whisper_models/
*.bin

# Virtual environments
venv/
venv*/

# Prepared training data (regenerable, binary)
*.npz
prepared_data/
# ...except the small Colab sample bundled with the repo
!sample_data/*.npz

# Sefaria API cache (regenerable)
Data_Prep/sefaria_cache/

# Local machine settings
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp

# Hebrew docs (git encoding issues)
*.gdoc

# ── v3 additions ───────────────────────────────────────────────────────────
# Derived spectrograms: 4.9 GB per window variant, rebuilt by
# Data_Prep/extract_features_v3.py from the alignments, which are tracked.
features_v3_*/
features_v2/

# Downloaded model weights (1.2 GB); models/wav2vec2-he is fetched by curl,
# see Data_Prep/ctc_align.py
models/

# Audio and the cloned PocketTorah tree
data/

# Whisper transcripts and per-recording cleaned metadata: large, and fully
# regenerable from the audio
metadata/
metadata_cleaned_v2/

# Training artifacts: checkpoints, embeddings, plots. The tables and logs under
# results/v3_comparison/ ARE tracked — that is the paper's evidence.
results/*
!results/v3_comparison/
results/v3_comparison/*.log

# Recorded audio + metadata from /api/verify_reading's no-match/ambiguous
# logging (webapp/server.py's log_attempt) -- local-only by design, never
# committed: this is other people's recorded voices, not project source.
app_assets/collected_attempts/

# Learner recordings exported from the Taamim Studio page, and the audio
# decoded from them. Same reason as collected_attempts/: other people's
# voices, local only.
incoming/
app_assets/user_recordings/

# Generated views. Both are rebuilt from live state by their scripts
# (build_ops_dashboard.py, export_knowledge_base.py), so committing them
# would just create a second source of truth that silently goes stale.
ops_dashboard.html
knowledge_base/

# wav2vec2 feature dumps — 8GB, fully regenerable
features_w2v/
features_w2v_pool/
features_w2v_seq/

# Job queue runtime state — every .job file is a generated one-off, and the
# logs/markers are per-run. The runner itself (run_queue.sh) is tracked.
jobs/
